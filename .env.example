# Oracle XE (docker-compose.yml) — copy to .env and fill in real values, never commit .env
ORACLE_PASSWORD=changeme_sys_password
ORACLE_APP_USER=autotrade
ORACLE_APP_USER_PASSWORD=changeme_app_password
# Host port mapped to the container's 1521. Defaults to 1522 because this machine
# already has a native Oracle listener (tnslsnr) bound to 1521 — override if your
# machine doesn't have that conflict.
ORACLE_HOST_PORT=1522

# Symmetric key(s) for encrypting broker_credentials ciphertext columns at
# rest (E1-F3-S1). Any string; each is SHA-256 hashed into a 256-bit AES key.
# Supports rotation: define CREDENTIAL_ENC_KEY_V1, then later add
# CREDENTIAL_ENC_KEY_V2 alongside it and point CREDENTIAL_ENC_ACTIVE_KEY_ID
# at v2 — see docs/runbooks/credential-key-rotation.md for the full
# procedure. Required in paper/prod; local/test fall back to an insecure
# dev-only key with a logged warning if unset.
CREDENTIAL_ENC_KEY_V1=
CREDENTIAL_ENC_ACTIVE_KEY_ID=v1

# Single-operator dashboard login (E1-F3-S2). DASHBOARD_PASSWORD_HASH is a
# bcrypt hash (required in paper/prod); local also accepts a plaintext
# DASHBOARD_PASSWORD for convenience (bcrypt-encoded at startup, logged
# warning). Never set both a real password and commit this file.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_HASH=

# Alpaca market-data API (E2-F1-S1) — historical bars for stock tickers.
# A free paper-trading key pair works for market data too (gated to the IEX
# feed by default). Required in paper/prod; local falls back to empty
# (price-history calls for STOCK tickers 503 until set). Binance market data
# needs no credentials — its klines endpoint is fully public.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Alpaca *trading* API (E4-F2-S1) — deliberately separate from ALPACA_API_KEY/
# ALPACA_API_SECRET above, which stay scoped to read-only market data. These
# are read once at startup by AlpacaTradingCredentialBootstrap and seeded into
# the encrypted broker_credentials store (E1-F3-S1) for (ALPACA, PAPER) if no
# row exists yet — the adapter itself always reads through that store, never
# these env vars directly. Leave unset and the adapter fails closed (no
# credential configured) rather than silently trading. Use a real Alpaca
# *paper* key pair, never a live one, until E6's live-mode gate exists.
ALPACA_TRADING_API_KEY=
ALPACA_TRADING_API_SECRET=
