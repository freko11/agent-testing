# Oracle XE (docker-compose.yml) — copy to .env and fill in real values, never commit .env
ORACLE_PASSWORD=changeme_sys_password
ORACLE_APP_USER=autotrade
ORACLE_APP_USER_PASSWORD=changeme_app_password
# Host port mapped to the container's 1521. Defaults to 1522 because this machine
# already has a native Oracle listener (tnslsnr) bound to 1521 — override if your
# machine doesn't have that conflict.
ORACLE_HOST_PORT=1522

# Symmetric key for encrypting broker_credentials ciphertext columns at rest
# (E1-F2-S1's minimal AES/GCM safeguard — full key rotation/keystore support
# is separate future work, F1.3). Any string; it's SHA-256 hashed into a
# 256-bit AES key. Required in paper/prod; local/test fall back to an
# insecure dev-only key with a logged warning if unset.
CREDENTIAL_ENC_KEY=
